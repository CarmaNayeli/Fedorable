# Fedorable - Zoo Animal Care Tracker
# Environment Variables Configuration

# ========================================
# DATABASE (Required)
# ========================================
# Your NEW Supabase PostgreSQL connection strings:

# Transaction Pooler - for app queries (with connection pooling via PgBouncer)
# Important: The ?pgbouncer=true parameter disables prepared statements to prevent conflicts
DATABASE_URL="postgresql://postgres.epgtaxmpbimksdgyjeto:UmoS06AxoFC0g80O@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection - for migrations (direct database access)
DIRECT_URL="postgresql://postgres:UmoS06AxoFC0g80O@db.epgtaxmpbimksdgyjeto.supabase.co:5432/postgres"

# ========================================
# PUSH NOTIFICATIONS (Required for notifications)
# ========================================
# Option 1: Use existing VAPID keys (below)
# Option 2: Generate new keys with: npx web-push generate-vapid-keys

# Public key (visible in browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BIRVUasoljkV_aBpat9Qlg7xikhAl7Bw7XX6eU5yNjsygnweavgiFYpSofyN2K5qiPl_FcVgfZKiie19Bh0JY4k"

# Private key (server-side only, keep secret!)
VAPID_PRIVATE_KEY="vR-gFSTLz0TNKhFTmaZsRXWMEXa8evYFN2owq-pLfmk"

# Email for VAPID identification
VAPID_SUBJECT="mailto:c_downen@yahoo.com"

# ========================================
# CRON JOBS (Optional - for scheduled notifications)
# ========================================
# Secret key for authenticating cron job requests
# Generate a random secret with: openssl rand -base64 32
# Or use any long random string
CRON_SECRET="your-random-secret-here-change-me"

# ========================================
# DEPLOYMENT (Production only)
# ========================================
# Uncomment for production deployment
# NODE_ENV="production"

# ========================================
# SETUP INSTRUCTIONS
# ========================================
# 1. Copy this file to .env (it's gitignored)
# 2. The database URLs above are already configured for your new Supabase instance
# 3. Run the migration: psql "your-direct-url" -f migration.sql
# 4. Generate Prisma client: npx prisma generate
# 5. Start dev server: npm run dev

# ========================================
# VERCEL DEPLOYMENT
# ========================================
# Add these environment variables in Vercel Project Settings:
# - DATABASE_URL
# - DIRECT_URL
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY
# - VAPID_PRIVATE_KEY
# - VAPID_SUBJECT
# - CRON_SECRET (optional, for scheduled notifications)
