// Fedorable: Zoo Animal Care Adventure
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Fedora - The Zookeeper
model MagicalGirl {
  id                String              @id @default(cuid())
  name              String              @default("Fedora")

  // Progression
  level             Int                 @default(1)
  xp                Int                 @default(0)
  sparklePoints     Int                 @default(0) // Zoo Coins
  magicGems         Int                 @default(0) // Treats
  sparkleShields    Int                 @default(0) // Vacation Days

  // Rank & Title
  rank              Int                 @default(1) // 1-5 star rank
  title             String              @default("Junior Zookeeper")
  prestigeLevel     Int                 @default(0)

  // Streaks
  currentStreak     Int                 @default(0)
  longestStreak     Int                 @default(0)
  lastActivityDate  DateTime?

  // Story Progress
  currentChapter    Int                 @default(0)
  mainStoryComplete Boolean             @default(false)

  // Stats
  totalMonstersDefeated Int             @default(0) // Total Tasks Completed

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  quests            Quest[]
  defeats           MonsterDefeat[]
  realms            Realm[]
  collections       Collection[]
  storyProgress     StoryChapter[]
  subscriptions     PushSubscription[]
  stickers          StickerCollection[]
}

// Realms (areas of the home)
model Realm {
  id                String              @id @default(cuid())
  name              String              // "kitchen", "bedroom", "bathroom", "livingRoom"
  displayName       String              // "Kitchen", "Bedroom", etc.
  emoji             String              @default("🏠")
  purity            Int                 @default(50) // 0-100%
  lastCleaned       DateTime?

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([magicalGirlId, name])
}

// Quests (chores reimagined as animal care tasks)
model Quest {
  id                String              @id @default(cuid())

  // Task/Animal Info
  monsterName       String              // "Feed the Penguins", "Clean Lion Habitat"
  monsterEmoji      String              @default("🦁")
  description       String?

  // Quest Type
  questType         String              @default("daily") // "daily", "weekly", "boss", "side", "onetime"
  realm             String?             // Which area/habitat this belongs to

  // Difficulty (care level)
  threatLevel       Int                 @default(2) // 1-5 stars

  // Rewards
  sparklePoints     Int                 @default(20) // Zoo Coins
  magicGems         Int                 @default(0) // Treats
  xpReward          Int                 @default(10)

  // Recurrence
  isRecurring       Boolean             @default(false)
  recurrenceRule    String?             // RRule format
  notificationPreferences Json?         // {"mon": "05:30", "tue": "05:30", ...}

  // Status
  isActive          Boolean             @default(true)
  completed         Boolean             @default(false)
  deadline          DateTime?
  lastCompletedAt   DateTime?           // Track when quest was last completed (for recurring quests)

  // Custom monster creation
  isCustom          Boolean             @default(false)
  createdByPlayer   Boolean             @default(false)

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  defeats           MonsterDefeat[]
  notifications     Notification[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// Task Completions (quest completions)
model MonsterDefeat {
  id                String              @id @default(cuid())
  defeatedAt        DateTime            @default(now())

  sparklePointsEarned Int               @default(0) // Zoo Coins Earned
  magicGemsEarned   Int                 @default(0) // Treats Earned
  xpEarned          Int                 @default(0)

  // Task completion flavor
  wasCriticalHit    Boolean             @default(false)
  battleText        String?

  questId           String
  quest             Quest               @relation(fields: [questId], references: [id], onDelete: Cascade)

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())
}

// Story Chapters
model StoryChapter {
  id                String              @id @default(cuid())
  chapterNumber     Int
  title             String
  content           String              // The story text
  unlocked          Boolean             @default(false)
  read              Boolean             @default(false)

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  unlockedAt        DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  @@unique([magicalGirlId, chapterNumber])
}

// Collections (bestiary, transformations, achievements)
model Collection {
  id                String              @id @default(cuid())
  collectionType    String              // "bestiary", "transformation", "achievement", "spell"
  itemId            String              // Unique identifier for the item
  itemName          String
  itemDescription   String?
  itemEmoji         String?

  unlocked          Boolean             @default(false)
  unlockedAt        DateTime?

  // Stats for bestiary entries
  timesEncountered  Int                 @default(0)
  timesDefeated     Int                 @default(0)

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([magicalGirlId, collectionType, itemId])
}

// Notifications (same as before but renamed for clarity)
model Notification {
  id                String              @id @default(cuid())
  scheduledFor      DateTime
  sent              Boolean             @default(false)
  snoozedUntil      DateTime?
  snoozeCount       Int                 @default(0)

  questId           String
  quest             Quest               @relation(fields: [questId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

// Push Subscriptions (unchanged)
model PushSubscription {
  id                String              @id @default(cuid())
  endpoint          String              @unique
  p256dh            String
  auth              String

  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())
}

// Shop Items - Stickers that can be purchased or earned
model ShopItem {
  id                String              @id @default(cuid())
  emoji             String              // The emoji/sticker
  name              String              // Name of the sticker
  category          String              // "cute", "nature", "food", "sparkle", "achievement", etc.
  price             Int                 // Cost amount
  currency          String              @default("gems") // "gems" or "sparkle_points"
  isLimited         Boolean             @default(false) // Limited edition items
  rarity            String              @default("common") // "common", "rare", "epic", "legendary"

  // Achievement stickers
  isAchievement     Boolean             @default(false) // True if earned through achievements
  achievementType   String?             // "quest_streak", "total_defeats", "perfect_week", etc.
  achievementTarget String?             // Quest ID or other target
  achievementGoal   Int?                // Number required (e.g., 7 days, 100 defeats)
  achievementDesc   String?             // Description of how to unlock

  createdAt         DateTime            @default(now())
}

// Sticker Collection - Stickers owned by the zookeeper
model StickerCollection {
  id                String              @id @default(cuid())

  shopItemId        String
  magicalGirlId     String
  magicalGirl       MagicalGirl         @relation(fields: [magicalGirlId], references: [id], onDelete: Cascade)

  purchasedAt       DateTime            @default(now())

  @@unique([shopItemId, magicalGirlId]) // Can't buy same sticker twice
}
